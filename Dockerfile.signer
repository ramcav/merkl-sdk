# The Merkl policy signer as a container: the dev keystore, the XRPL codec,
# nothing else. One volume holds everything the signer owns — the keystore,
# the sealed rule state, the relay tokens and the signed policy — so a
# treasury's signer is the image plus that volume, and nothing on the host.
#
#   docker run --rm -v merkl-signer:/var/lib/merkl-signer -p 127.0.0.1:8787:8787 \
#     ghcr.io/ramcav/merkl-signer:0.2.0
#
# Every subcommand of the CLI is reachable through the same entrypoint, so the
# keystore is created where it will be served from:
#
#   docker run --rm -it -v merkl-signer:/var/lib/merkl-signer ghcr.io/ramcav/merkl-signer:0.2.0 \
#     treasury init --xrpl-testnet --home /var/lib/merkl-signer
#
# Unattested, and every receipt it signs says so. nitro/ is the attested build.
FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/ramcav/merkl-sdk" \
      org.opencontainers.image.description="Merkl policy signer (dev keystore, XRPL codec)"

COPY . /src
RUN pip install --no-cache-dir "/src[signer-xrpl]" && rm -rf /src

# The signer runs unprivileged. The entrypoint, when started as root (the
# default, so a bind mount from the host still works), takes ownership of the
# volume once and drops to this user before anything of the signer's runs.
RUN useradd --system --uid 10001 --user-group --no-create-home merkl \
    && mkdir -p /var/lib/merkl-signer && chown merkl:merkl /var/lib/merkl-signer

COPY docker/signer-entrypoint.sh /usr/local/bin/signer-entrypoint
RUN chmod 0755 /usr/local/bin/signer-entrypoint

VOLUME ["/var/lib/merkl-signer"]
EXPOSE 8787

ENTRYPOINT ["signer-entrypoint"]
CMD ["signer", "serve", \
     "--policy", "/var/lib/merkl-signer/policy.signed.json", \
     "--home", "/var/lib/merkl-signer", \
     "--host", "0.0.0.0", "--port", "8787"]
